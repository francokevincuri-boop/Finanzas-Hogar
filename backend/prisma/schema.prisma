// Schema Fases 1, 2 y 3 — traducción directa del modelo de CLAUDE.md §5
// Fase 1: Usuario, Hogar, MiembroHogar, Cuenta, Categoria, Transaccion
// Fase 2: Tarjeta, ConsumoTarjeta, Cuota + transferencias (cuenta_destino_id)
// Fase 3: Servicio, PagoServicio, Presupuesto (vencimientos se calculan al vuelo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuarios y hogares ────────────────────────────────────────────

model Usuario {
  id           String         @id @default(uuid())
  email        String         @unique
  nombre       String
  passwordHash String         @map("password_hash")
  creadoEn     DateTime       @default(now()) @map("creado_en")
  membresias   MiembroHogar[]

  @@map("usuarios")
}

model Hogar {
  id            String         @id @default(uuid())
  nombre        String
  monedaBase    String         @default("ARS") @map("moneda_base")
  creadoEn      DateTime       @default(now()) @map("creado_en")
  miembros      MiembroHogar[]
  cuentas       Cuenta[]
  categorias    Categoria[]
  transacciones Transaccion[]
  tarjetas      Tarjeta[]
  servicios     Servicio[]
  presupuestos  Presupuesto[]

  @@map("hogares")
}

enum RolMiembro {
  dueno
  colaborador
  lector
}

// Cubre el caso "hija administra el hogar de los padres":
// un usuario puede ser miembro de varios hogares con roles distintos.
model MiembroHogar {
  id            String        @id @default(uuid())
  usuarioId     String        @map("usuario_id")
  hogarId       String        @map("hogar_id")
  rol           RolMiembro    @default(dueno)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  hogar         Hogar         @relation(fields: [hogarId], references: [id])
  transacciones Transaccion[]

  @@unique([usuarioId, hogarId])
  @@map("miembros_hogar")
}

// ── Cuentas, categorías y transacciones ───────────────────────────

enum TipoCuenta {
  efectivo
  banco
  billetera
  usd
  inversion
}

model Cuenta {
  id            String        @id @default(uuid())
  hogarId       String        @map("hogar_id")
  nombre        String
  tipo          TipoCuenta
  moneda        String        @default("ARS")
  saldoActual   Decimal       @default(0) @map("saldo_actual") @db.Decimal(15, 2)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  hogar         Hogar         @relation(fields: [hogarId], references: [id])
  transacciones Transaccion[] @relation("TransaccionesOrigen")
  transferenciasRecibidas Transaccion[] @relation("TransaccionesDestino")

  @@index([hogarId])
  @@map("cuentas")
}

enum TipoCategoria {
  gasto
  ingreso
}

model Categoria {
  id            String        @id @default(uuid())
  hogarId       String        @map("hogar_id")
  nombre        String
  tipo          TipoCategoria
  esFijo        Boolean       @default(false) @map("es_fijo")
  hogar         Hogar         @relation(fields: [hogarId], references: [id])
  transacciones Transaccion[]
  presupuestos  Presupuesto[]

  @@index([hogarId])
  @@map("categorias")
}

enum TipoTransaccion {
  ingreso
  gasto
  transferencia
}

model Transaccion {
  id              String          @id @default(uuid())
  hogarId         String          @map("hogar_id")
  cuentaId        String          @map("cuenta_id")
  cuentaDestinoId String?         @map("cuenta_destino_id") // solo transferencias: a dónde va la plata
  categoriaId     String?         @map("categoria_id")
  miembroId       String?         @map("miembro_id")
  tipo            TipoTransaccion
  monto           Decimal         @db.Decimal(15, 2)
  moneda          String          @default("ARS")
  fecha           DateTime        @db.Date
  descripcion     String?
  compartida      Boolean         @default(false)
  creadoEn        DateTime        @default(now()) @map("creado_en")
  hogar           Hogar           @relation(fields: [hogarId], references: [id])
  cuenta          Cuenta          @relation("TransaccionesOrigen", fields: [cuentaId], references: [id])
  cuentaDestino   Cuenta?         @relation("TransaccionesDestino", fields: [cuentaDestinoId], references: [id])
  categoria       Categoria?      @relation(fields: [categoriaId], references: [id])
  miembro         MiembroHogar?   @relation(fields: [miembroId], references: [id])

  @@index([hogarId, fecha])
  @@map("transacciones")
}

// ── Fase 2: Tarjetas de crédito y cuotas ──────────────────────────

model Tarjeta {
  id             String           @id @default(uuid())
  hogarId        String           @map("hogar_id")
  nombre         String // ej: "Visa Galicia"
  banco          String?
  limite         Decimal?         @db.Decimal(15, 2)
  diaCierre      Int              @map("dia_cierre") // día del mes en que cierra el resumen
  diaVencimiento Int              @map("dia_vencimiento") // día del mes en que vence el pago
  creadoEn       DateTime         @default(now()) @map("creado_en")
  hogar          Hogar            @relation(fields: [hogarId], references: [id])
  consumos       ConsumoTarjeta[]

  @@index([hogarId])
  @@map("tarjetas")
}

model ConsumoTarjeta {
  id          String   @id @default(uuid())
  tarjetaId   String   @map("tarjeta_id")
  descripcion String
  montoTotal  Decimal  @map("monto_total") @db.Decimal(15, 2)
  fecha       DateTime @db.Date // fecha de la compra
  enCuotas    Boolean  @default(false) @map("en_cuotas")
  creadoEn    DateTime @default(now()) @map("creado_en")
  tarjeta     Tarjeta  @relation(fields: [tarjetaId], references: [id])
  cuotas      Cuota[]

  @@index([tarjetaId])
  @@map("consumos_tarjeta")
}

// ── Fase 3: Servicios, pagos y presupuesto por sobres ─────────────

enum Periodicidad {
  mensual
  bimestral
  anual
}

model Servicio {
  id             String         @id @default(uuid())
  hogarId        String         @map("hogar_id")
  nombre         String // ej: "Luz (Edesur)"
  montoEstimado  Decimal        @map("monto_estimado") @db.Decimal(15, 2)
  periodicidad   Periodicidad   @default(mensual)
  diaVencimiento Int            @map("dia_vencimiento")
  mesAncla       Int            @default(1) @map("mes_ancla") // para bimestrales/anuales: mes de referencia (1-12)
  activo         Boolean        @default(true)
  creadoEn       DateTime       @default(now()) @map("creado_en")
  hogar          Hogar          @relation(fields: [hogarId], references: [id])
  pagos          PagoServicio[]

  @@index([hogarId])
  @@map("servicios")
}

// El estado "pagado" de un servicio vive acá, en el origen (decisión §12)
model PagoServicio {
  id          String   @id @default(uuid())
  servicioId  String   @map("servicio_id")
  periodo     String // "2026-06" → qué mes/período se pagó
  montoPagado Decimal? @map("monto_pagado") @db.Decimal(15, 2)
  creadoEn    DateTime @default(now()) @map("creado_en")
  servicio    Servicio @relation(fields: [servicioId], references: [id])

  @@unique([servicioId, periodo])
  @@map("pagos_servicio")
}

// Sobres: cada peso tiene un trabajo (estilo YNAB)
model Presupuesto {
  id            String    @id @default(uuid())
  hogarId       String    @map("hogar_id")
  categoriaId   String    @map("categoria_id")
  mes           String // "2026-06"
  montoAsignado Decimal   @map("monto_asignado") @db.Decimal(15, 2)
  hogar         Hogar     @relation(fields: [hogarId], references: [id])
  categoria     Categoria @relation(fields: [categoriaId], references: [id])

  @@unique([hogarId, categoriaId, mes])
  @@map("presupuestos")
}

model Cuota {
  id               String         @id @default(uuid())
  consumoId        String         @map("consumo_id")
  numero           Int // cuota 3...
  totalCuotas      Int            @map("total_cuotas") // ...de 12
  monto            Decimal        @db.Decimal(15, 2)
  fechaVencimiento DateTime       @map("fecha_vencimiento") @db.Date // en qué resumen cae
  pagada           Boolean        @default(false)
  consumo          ConsumoTarjeta @relation(fields: [consumoId], references: [id])

  @@index([consumoId])
  @@index([fechaVencimiento])
  @@map("cuotas")
}
