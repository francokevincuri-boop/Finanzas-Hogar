// Schema Fase 1 — traducción directa del modelo de CLAUDE.md §5
// Entidades: Usuario, Hogar, MiembroHogar, Cuenta, Categoria, Transaccion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuarios y hogares ────────────────────────────────────────────

model Usuario {
  id           String         @id @default(uuid())
  email        String         @unique
  nombre       String
  passwordHash String         @map("password_hash")
  creadoEn     DateTime       @default(now()) @map("creado_en")
  membresias   MiembroHogar[]

  @@map("usuarios")
}

model Hogar {
  id            String         @id @default(uuid())
  nombre        String
  monedaBase    String         @default("ARS") @map("moneda_base")
  creadoEn      DateTime       @default(now()) @map("creado_en")
  miembros      MiembroHogar[]
  cuentas       Cuenta[]
  categorias    Categoria[]
  transacciones Transaccion[]

  @@map("hogares")
}

enum RolMiembro {
  dueno
  colaborador
  lector
}

// Cubre el caso "hija administra el hogar de los padres":
// un usuario puede ser miembro de varios hogares con roles distintos.
model MiembroHogar {
  id            String        @id @default(uuid())
  usuarioId     String        @map("usuario_id")
  hogarId       String        @map("hogar_id")
  rol           RolMiembro    @default(dueno)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  hogar         Hogar         @relation(fields: [hogarId], references: [id])
  transacciones Transaccion[]

  @@unique([usuarioId, hogarId])
  @@map("miembros_hogar")
}

// ── Cuentas, categorías y transacciones ───────────────────────────

enum TipoCuenta {
  efectivo
  banco
  billetera
  usd
  inversion
}

model Cuenta {
  id            String        @id @default(uuid())
  hogarId       String        @map("hogar_id")
  nombre        String
  tipo          TipoCuenta
  moneda        String        @default("ARS")
  saldoActual   Decimal       @default(0) @map("saldo_actual") @db.Decimal(15, 2)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  hogar         Hogar         @relation(fields: [hogarId], references: [id])
  transacciones Transaccion[]

  @@index([hogarId])
  @@map("cuentas")
}

enum TipoCategoria {
  gasto
  ingreso
}

model Categoria {
  id            String        @id @default(uuid())
  hogarId       String        @map("hogar_id")
  nombre        String
  tipo          TipoCategoria
  esFijo        Boolean       @default(false) @map("es_fijo")
  hogar         Hogar         @relation(fields: [hogarId], references: [id])
  transacciones Transaccion[]

  @@index([hogarId])
  @@map("categorias")
}

enum TipoTransaccion {
  ingreso
  gasto
  transferencia
}

model Transaccion {
  id          String          @id @default(uuid())
  hogarId     String          @map("hogar_id")
  cuentaId    String          @map("cuenta_id")
  categoriaId String?         @map("categoria_id")
  miembroId   String?         @map("miembro_id")
  tipo        TipoTransaccion
  monto       Decimal         @db.Decimal(15, 2)
  moneda      String          @default("ARS")
  fecha       DateTime        @db.Date
  descripcion String?
  compartida  Boolean         @default(false)
  creadoEn    DateTime        @default(now()) @map("creado_en")
  hogar       Hogar           @relation(fields: [hogarId], references: [id])
  cuenta      Cuenta          @relation(fields: [cuentaId], references: [id])
  categoria   Categoria?      @relation(fields: [categoriaId], references: [id])
  miembro     MiembroHogar?   @relation(fields: [miembroId], references: [id])

  @@index([hogarId, fecha])
  @@map("transacciones")
}
